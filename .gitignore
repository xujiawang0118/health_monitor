# ─── 编译产物 ───
# 四种构建模式各有独立目录（见 Makefile），逐个列出而不是用 build*/
# 通配，免得误伤将来叫 build_something 的源码目录。
build/
build_cross/
build_asan/
build_mock/
*.o
*.elf
*.bin
*.so
*.a

# ─── 敏感信息：华为云三元组（真实值在本地私有文件，勿提交）───
include/cloud_secret.h

# ─── Python ───
__pycache__/
venv/
*.pyc

# ─── 运行数据（client/data/.gitignore 已排除 *.jsonl，此处兜底）───
client/data/*.jsonl

# ─── 运行期状态目录 ───
# 看门狗统计文件的兜底落点（STATE_DIR 解析不到时退化成 ./demo）
demo/

# ─── 编辑器 / 杂项 ───
.vscode/
*.swp
*.log
