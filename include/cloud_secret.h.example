/**
 * @file    cloud_secret.h.example
 * @brief   华为云 IoTDA 三元组模板 — 复制为 cloud_secret.h 并填入真实值
 *
 * 使用步骤：
 *   1. cp cloud_secret.h.example cloud_secret.h
 *   2. 填入华为云 IoTDA 控制台获取的三元组（产品详情 → 设备信息 → 接入信息）
 *   3. cloud_secret.h 已在 .gitignore 中，不会被 git 追踪
 */

#ifndef CLOUD_SECRET_H
#define CLOUD_SECRET_H

#define MQTT_CLOUD_PRODUCT_KEY   "在这里填入 ProductKey"
#define MQTT_CLOUD_DEVICE_NAME   "在这里填入 DeviceName"
#define MQTT_CLOUD_DEVICE_SECRET "在这里填入 DeviceSecret"
#define MQTT_CLOUD_BROKER        "在这里填入设备接入地址"

#endif /* CLOUD_SECRET_H */
